<% search_label = t("inline_forms.search.label", default: t("inline_forms.search.placeholder")) %>
<%= form_tag request.path, method: :get, role: "search" do %>
  <div class="row collapse">
    <div class="large-1 small-1 columns">
      <%= link_to tag.i(class: "fi-x", "aria-hidden": "true"), request.path, title: t("inline_forms.search.reset"), "aria-label": t("inline_forms.search.reset"), class: "button expanded inline_forms_model_top_bar_buttons" %>
    </div>
    <div class="large-6 small-6 columns">
      <%# With `inline_forms_search_on …, suggest: …` the list itself answers %>
      <%# the suggestions (index with ?suggest=1&term=…). %>
      <% if @Klass.respond_to?(:inline_forms_suggestions) && @Klass.inline_forms_suggestions %>
        <%= suggest_field_tag :search, params[:search], "#{request.path}?suggest=1", placeholder: t("inline_forms.search.placeholder"), "aria-label": search_label, id: "input_search", list: "input_search_suggestions" %>
      <% else %>
        <%= text_field_tag :search, params[:search], placeholder: t("inline_forms.search.placeholder"), "aria-label": search_label, id: "input_search" %>
      <% end %>
    </div>
    <div class="large-3 small-3 columns">
      <%= submit_tag t("inline_forms.search.submit"), class: "button expanded inline_forms_model_top_bar_buttons" %>
    </div>
    <div class="large-2 small-2 columns">
      &nbsp;
    </div>
  </div>
<% end %>
