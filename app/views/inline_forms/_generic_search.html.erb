<%= form_tag request.path, method: :get do %>
  <div class="row collapse">
    <div class="large-1 small-1 columns">
      <%= link_to tag.i(class: "fi-x"), request.path, title: t("inline_forms.search.reset"), class: "button expanded inline_forms_model_top_bar_buttons" %>
    </div>
    <div class="large-6 small-6 columns">
      <%= text_field_tag :search, params[:search], placeholder: t("inline_forms.search.placeholder"), id: "input_search" %>
    </div>
    <div class="large-3 small-3 columns">
      <%= submit_tag t("inline_forms.search.submit"), class: "button expanded inline_forms_model_top_bar_buttons" %>
    </div>
    <div class="large-2 small-2 columns">
      &nbsp;
    </div>
  </div>
<% end %>
