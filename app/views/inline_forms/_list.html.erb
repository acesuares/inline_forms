<% ul_needed = true %>
<% pagination = true %>
<% if not defined?(parent_class)  %>
  <%   # we didn't come here via _show.html.erb %>
  <%  if @parent_class.nil? %>
    <% # the controller didn't give us a parent_class, this means we are here for the 'first' time  %>
    <% # we have to rely on the @Klass set in the controller %>
    <% update_span = @Klass.to_s.pluralize.downcase + '_list'  %>
    <% path_to_new = "new_#{@Klass.to_s.singularize.underscore}_path" %>
    <% parent_class = nil %>
    <% parent_id = nil  %>
    <% objects = @objects %>
    <% model = @Klass %>
  <% else %>
    <% # the controller gave us an @parent_class, so ... %>
    <% attribute = @Klass.to_s.underscore.pluralize %>
    <% update_span = "#{@parent_class.to_s.underscore}_#{@parent_id}_#{attribute}_list" -%>
    <% path_to_new='new_' + attribute.to_s.underscore.singularize + '_path' %>
    <% parent_class=@parent_class.constantize %>
    <% parent_id=@parent_id %>
    <% objects = @objects %>
    <% ul_needed = false unless @ul_needed %>
    <% model = attribute.to_s.singularize.camelcase.constantize %>
  <% end %>
<% else %>
  <% # here we come from _show %>
  <% if form_element == :has_one %>
    <% update_span = "#{parent_class.to_s.underscore}_#{parent_id}_#{attribute}_list" -%>
    <% objects = [ parent_class.find(parent_id).send(attribute) ] %>
    <% pagination = false %>
  <% else %>
    <% update_span = "#{parent_class.to_s.underscore}_#{parent_id}_#{attribute}_list" -%>
    <% path_to_new='new_' + attribute.to_s.singularize + '_path' %>
    <% foreign_key = parent_class.reflect_on_association(attribute.to_sym).options[:foreign_key] || parent_class.name.foreign_key -%>
    <% model = attribute.to_s.singularize.camelcase.constantize %>
    <% conditions =  [ "#{model.table_name}.#{foreign_key} = ?", parent_id ] %>
    <% objects = parent_class.find(parent_id).send(attribute) %>
    <% objects = parent_class.find(parent_id).send(attribute).accessible_by(current_ability) if cancan_enabled? %>
    <% objects = objects.order(attribute.to_s.singularize.camelcase.constantize.order_by_clause) if attribute.to_s.singularize.camelcase.constantize.respond_to?(:order_by_clause) && ! attribute.to_s.singularize.camelcase.constantize.order_by_clause.nil? %>
    <% objects = objects.where(conditions).paginate(:page => params[:page]) %>
  <% end %>
<% end %>

<%# List root is `<turbo-frame class="list_container">` (Step 4). See SCSS. %>
<% if ul_needed -%>
  <%= raw "<turbo-frame id=\"#{update_span}\" class=\"list_container\">" -%>
<% end -%>

<!--  # list of objects -->
<% for object in objects %>
  <% if parent_class.nil?  %>
    <% css_class_id = object.class.to_s.underscore + '_' + object.id.to_s -%>
    <% path_to_object = object.class.to_s.underscore + '_path' %>
  <% else %>
    <% css_class_id = parent_class.to_s.underscore + '_' + parent_id.to_s + '_' + attribute.to_s.singularize.underscore + "_" + object.id.to_s -%>
    <% path_to_object = attribute.to_s.singularize.underscore + "_path" %>
  <% end %>
  <% row_open_link_opts = { data: { turbo: true, turbo_frame: css_class_id } } %>
  <%#
    Each list row is `<turbo-frame id="…">` with a Turbo presentation link
    (GET `show` / `close` as HTML). Nested rows use the same contract as
    top-level; `not_accessible_through_html?` child models (Photo) still
    serve `format.html` when `params[:update]` matches a nested row id.
  -%>
  <% if parent_class.nil? -%>
    <%= tag.turbo_frame(id: css_class_id) do %>
      <div class="row <%= cycle('odd', 'even') %> top-level">
        <% if cancan_disabled? || ( can? :soft_delete, object ) %>
          <div  class="small-1 column">
            <%= link_to_soft_delete(object, css_class_id) -%>
            <%= link_to_destroy(object, css_class_id) -%>
          </div>
          <div  class="small-11 column">
            <%= link_to h(object._presentation),
              send( path_to_object, object, :update => css_class_id),
              row_open_link_opts -%>
          </div>
        <% else %>
          <div  class="small-12 column">
            <%= link_to h(object._presentation),
              send( path_to_object, object, :update => css_class_id),
              row_open_link_opts -%>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else -%>
    <%= tag.turbo_frame(id: css_class_id) do %>
      <div class="row <%= cycle('odd', 'even') %>">
        <% if cancan_disabled? || ( can? :soft_delete, object ) %>
          <div  class="small-1 column">
            <%= link_to_soft_delete(object, css_class_id) -%>
            <%= link_to_destroy(object, css_class_id) -%>
          </div>
          <div  class="small-11 column">
            <%= link_to h(object._presentation),
              send( path_to_object, object, :update => css_class_id),
              row_open_link_opts -%>
          </div>
        <% else %>
          <div  class="small-12 column">
            <%= link_to h(object._presentation),
              send( path_to_object, object, :update => css_class_id),
              row_open_link_opts -%>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end -%>
<% end -%>
<!--  # pagination -->
<% if parent_id.nil? -%>
  <% paginate_params = { update: update_span, ul_needed: true } %>
  <% paginate_params[:search] = params[:search] if params[:search].present? %>
  <% pagination = will_paginate objects, params: paginate_params %>
<% else %>
  <% if pagination %>
    <%#
      Nested pagination is now driven by the surrounding <turbo-frame>:
      the link's same-URL GET returns a fresh frame and Turbo swaps
      just that region. No more remote: true + list.js.erb on the
      pagination path.

      The `update:` param must match the frame's id (`<update_span>`,
      which is `…_list`). The legacy UJS pagination passed the OUTER
      wrapper's id (`…` without `_list`) because list.js.erb did
      `$('#<outer>').html(<rendered _list partial>)` and needed the
      outer container, not the inner one. Turbo Frames swaps the
      element with the matching id, so the param now carries the
      frame id itself; otherwise the response (`<turbo-frame
      id="…_list">`) and the request expectation (`Turbo-Frame:
      <update_span>` derived from the URL `update=…` param) would
      disagree and Turbo would log "the response did not contain the
      expected <turbo-frame>" and ignore the page.
    -%>
    <% pagination = will_paginate objects, :params => {:controller => attribute, :action => :index, :id => nil, :parent_class => parent_class, :parent_id => parent_id, :update => "#{parent_class.to_s.underscore}_#{parent_id}_#{attribute}_list", :ul_needed => true } %>
  <% end %>
<% end %>
<% if pagination %>
  <div class="row <%= cycle('odd', 'even') %>">
    <div class='small-11 small-centered column'>
      <%= raw pagination %>
    </div>
  </div>
<% end %>
<% if ul_needed -%>
  <%= raw "</turbo-frame>" -%>
<% end -%>
