<div class="new_record"">
 <div id="flash" class="row">
    <%# Only validation feedback from InlineFormsController#create (flash.now); %>
    <%# never dump session flash (:notice / :alert from Devise, etc.). %>
    <% %w[header error success].each do |key| %>
      <% value = flash[key] %>
      <% next if value.blank? %>
      <div class="flash <%= key %>">
        <ul>
          <% if value.is_a?(Array) %>
            <% value.each do |msg| %>
              <li>
                <%= msg %>
              </li>
            <% end %>
          <% else %>
            <li>
              <%= value %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <div class="row" >
    <div class="large-12 column object_presentation" >
      <%= t('inline_forms.view.add_new', :model => @Klass.model_name.human ) -%>
    </div>
  </div>

  <% new_form_opts = { multipart: true, class: "edit_form" } %>
  <% if @update_span.present? %>
    <% new_form_opts[:data] = { turbo: true, turbo_frame: @update_span } %>
  <% end %>
  <%= form_tag polymorphic_path(@Klass,
        update: @update_span,
        parent_class: @parent_class,
        parent_id: @parent_id),
      new_form_opts do -%>
    <% attributes = @inline_forms_attribute_list || @object.inline_forms_attribute_list -%>
    <% attributes.each do | attribute, name, form_element | -%>
      <% unless form_element.to_sym == :associated || (cancan_enabled? && cannot?(:read, @object, attribute)) -%>
        <% css_class_id = "attribute_#{attribute}_#{@object.id}" -%>
        <% if form_element && form_element.to_sym == :header %>
          <div class="row form_element_header" >
            <div class='large-12 column<%= " attribute_name attribute_#{attribute} form_element_#{form_element}" -%>' >
              <%= @object.human_attribute_name(attribute) -%>
            </div>
          </div>
        <% else %>
          <div class="row <%= cycle('odd', 'even') %>">
            <div class='medium-5 large-5 column' >
              <%= render partial: "inline_forms/attribute_label",
                    locals: { object: @object, attribute: attribute } -%>
            </div>
            <div class='medium-7 large-7 column' >
              <span id="<%= css_class_id -%>" > <%= send("#{form_element}_edit", @object, attribute) -%> </span>
            </div>
          </div>
        <% end -%>
      <% end -%>
    <% end -%>
    <div class="row <%= cycle('odd', 'even') %>">
                  <div class='medium-1 large-1 column'>
                  &nbsp;
                </div>
    <div class='small-11  column' >
        <% cancel_path = polymorphic_path(@Klass,
              update: @update_span,
              parent_class: @parent_class,
              parent_id: @parent_id,
              ul_needed: true) %>
        <% cancel_opts = @update_span.present? ? inline_forms_turbo_link_data(@update_span) : {} %>
        <%= link_to cancel_path, cancel_opts do -%>
          <input type="button" name="cancel" value="cancel" class="button alert" />
        <% end %>
        <%= submit_tag "ok", :class => "button "-%>
      </div>
    </div>
    <div class="row record_footer"></div>
  <% end %>
</div>
