<!DOCTYPE html>
<%# class="no-js": Foundation's CSS hides the top-bar submenus while it is set %>
<%# and its JS removes it on the first init, so the submenus do not show as %>
<%# plain lists before then. Turbo Drive never puts it back; after a visit %>
<%# inline_forms.js initialises the new body on turbo:load, and the %>
<%# `[data-dropdown-menu]` rule in inline_forms.scss covers any gap. %>
<html lang="<%= I18n.locale %>" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%# A missing translation must not reach <title>: a bare t() returns an %>
    <%# html_safe <span class="translation_missing"> that shows up as markup. %>
    <%# inline_forms_application_title always has a plain-text fallback. %>
    <title><%= inline_forms_application_title %> v<%= InlineForms::VERSION %></title>
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "inline_forms_fonts" %>
    <%= stylesheet_link_tag "inline_forms/inline_forms" %>
    <%= stylesheet_link_tag "trix" %>
    <%= inline_forms_user_color_overrides_style %>
    <%= csrf_meta_tags %>
    <%# Publishes the CSP nonce (nothing without a nonce generator) for the %>
    <%# scripts Turbo inserts. %>
    <%= csp_meta_tag %>
    <%# In <head>, so Turbo Drive runs them once: it keeps head scripts across %>
    <%# visits (a body script runs again on every visit, with a fresh jQuery), %>
    <%# and appends them, in order, on a visit from a page that lacks them. %>
    <%# Tippy.js (v6) needs Popper.js as a global before its UMD factory runs %>
    <%# (`tippy-bundle.umd.min` only bundles default themes, not Popper itself). %>
    <%# inline_forms.js initialises Foundation on the ready event and on %>
    <%# turbo:load, once per <body>. %>
    <%= javascript_include_tag 'popper.min' %>
    <%= javascript_include_tag 'tippy-bundle.umd.min' %>
    <%= javascript_include_tag 'inline_forms/inline_forms' %>
  </head>

  <body class="<%= inline_forms_body_theme_class %>">
    <%= render "inline_forms/header" %>
    <%# Read string keys (FlashHash stores strings); avoid `notice`/`alert` helpers %>
    <%# so we do not depend on add_flash_types wiring in every layout context. %>
    <% flash_notice = flash["notice"] %>
    <% flash_alert = flash["alert"] %>
    <% if flash_notice.present? || flash_alert.present? %>
      <div class="row" id="inline_forms_layout_flash" role="status">
        <% if flash_notice.present? %><div class="flash notice"><%= flash_notice %></div><% end %>
        <% if flash_alert.present? %><div class="flash alert"><%= flash_alert %></div><% end %>
      </div>
    <% end %>
    <%= render "inline_forms/model_top_bar" %>
    <div id="outer_container">
      <%= yield %>
    </div>
    <%# Turbo (Hotwire) is loaded as an ES module so it does not collide with %>
    <%# the classic-script Sprockets bundle above. Drive stays at the default %>
    <%# (enabled); inline interactions use `<turbo-frame>` + HTML responses. %>
    <%# The nonce: hosts run a CSP with script-src 'nonce-…' (nil, so no %>
    <%# attribute, without a nonce generator). data-turbo-eval="false": Turbo %>
    <%# Drive must not re-run it on visits (Turbo is loaded; a re-inserted %>
    <%# copy would carry a newer nonce the page's policy rejects). %>
    <%= tag.script type: "module", nonce: content_security_policy_nonce, data: { turbo_eval: false } do %>
      import { Turbo } from "<%= asset_path('turbo.min.js') %>"
      window.Turbo = Turbo
    <% end %>
    <%# Trix 2 (vendored; no CDN). Self-registers its custom elements on load. %>
    <%= javascript_include_tag "trix.min" %>
  </body>
</html>
