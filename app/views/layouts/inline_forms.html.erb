<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('application_name') + " v" + InlineForms::VERSION -%></title>
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "inline_forms/inline_forms" %>
    <%= stylesheet_link_tag "https://unpkg.com/trix@1.3.1/dist/trix.css" %>
    <%= csrf_meta_tags %>
  </head>

  <body>
    <%= render "inline_forms/header" %>
    <% if notice.present? || alert.present? %>
      <div class="row" id="inline_forms_layout_flash" role="status">
        <% if notice.present? %><div class="flash notice"><%= notice %></div><% end %>
        <% if alert.present? %><div class="flash alert"><%= alert %></div><% end %>
      </div>
    <% end %>
    <%= render "/inline_forms_tabs" %>
    <div id="outer_container">
      <%= yield %>
    </div>
    <%= javascript_include_tag 'inline_forms/inline_forms' %>
    <%# Turbo (Hotwire) is loaded as an ES module so it does not collide with %>
    <%# the classic-script Sprockets bundle above (jquery_ujs etc.). Drive is %>
    <%# disabled here so existing UJS-driven links/forms keep working unchanged; %>
    <%# `<turbo-frame>` and `format.turbo_stream` are still available for the %>
    <%# per-view conversions that follow this slice. %>
    <script type="module">
      import { Turbo } from "<%= asset_path('turbo.min.js') %>"
      Turbo.session.drive = false
      window.Turbo = Turbo
    </script>
    <%= javascript_include_tag "https://unpkg.com/trix@1.3.1/dist/trix.js" %>
  </body>
</html>
