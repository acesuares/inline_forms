<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('application_name') + " v" + InlineForms::VERSION -%></title>
    <%= stylesheet_link_tag "application" %>
    <%= stylesheet_link_tag "inline_forms_fonts" %>
    <%= stylesheet_link_tag "inline_forms/inline_forms" %>
    <%= stylesheet_link_tag "trix" %>
    <%= csrf_meta_tags %>
  </head>

  <body>
    <%= render "inline_forms/header" %>
    <%# Read string keys (FlashHash stores strings); avoid `notice`/`alert` helpers %>
    <%# so we do not depend on add_flash_types wiring in every layout context. %>
    <% flash_notice = flash["notice"] %>
    <% flash_alert = flash["alert"] %>
    <% if flash_notice.present? || flash_alert.present? %>
      <div class="row" id="inline_forms_layout_flash" role="status">
        <% if flash_notice.present? %><div class="flash notice"><%= flash_notice %></div><% end %>
        <% if flash_alert.present? %><div class="flash alert"><%= flash_alert %></div><% end %>
      </div>
    <% end %>
    <%= render "/inline_forms_tabs" %>
    <div id="outer_container">
      <%= yield %>
    </div>
    <%# Tippy.js (v6) needs Popper.js as a global before its UMD factory runs %>
    <%# (`tippy-bundle.umd.min` only bundles default themes, not Popper itself). %>
    <%= javascript_include_tag 'popper.min' %>
    <%= javascript_include_tag 'tippy-bundle.umd.min' %>
    <%= javascript_include_tag 'inline_forms/inline_forms' %>
    <%# Turbo (Hotwire) is loaded as an ES module so it does not collide with %>
    <%# the classic-script Sprockets bundle above. Drive stays at the default %>
    <%# (enabled); inline interactions use `<turbo-frame>` + HTML responses. %>
    <script type="module">
      import { Turbo } from "<%= asset_path('turbo.min.js') %>"
      window.Turbo = Turbo
    </script>
    <%# Trix 2 (vendored; no CDN). Self-registers its custom elements on load. %>
    <%= javascript_include_tag "trix.min" %>
  </body>
</html>
